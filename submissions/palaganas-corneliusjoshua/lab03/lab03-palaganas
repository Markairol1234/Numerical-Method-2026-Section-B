import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.backends.backend_pdf import PdfPages
import warnings
warnings.filterwarnings('ignore')

# Set font to Arial globally for plots
plt.rcParams['font.family'] = 'Arial'
plt.rcParams['font.size'] = 12

# ============================================================
# STEP 1: Data Acquisition
# ============================================================
# Source: The World Bank
# URL: https://datacatalog.worldbank.org/search/dataset/0037712/world-development-indicators

data = {
    'Country': [
        'Norway', 'Switzerland', 'USA', 'Singapore', 'Australia',
        'Germany', 'Canada', 'UK', 'France', 'Japan',
        'South Korea', 'Mexico', 'Turkey', 'Brazil', 'Russia',
        'China', 'India', 'Nigeria', 'South Africa', 'Kenya'
    ],
    'GDP_per_capita': [
        88000, 82000, 76000, 68000, 65000,
        52000, 51000, 48000, 45000, 42000,
        34000, 19000, 17000, 15000, 14000,
        12000,  7200,  4200,  6800,  4800
    ],
    'Life_expectancy': [
        83.3, 83.9, 77.3, 83.7, 83.5,
        81.2, 82.7, 81.0, 82.6, 84.8,
        83.5, 74.2, 77.5, 75.8, 72.4,
        78.2, 70.1, 60.2, 65.3, 66.5
    ]
}

df = pd.DataFrame(data)
x = df['GDP_per_capita'].values
y = df['Life_expectancy'].values
n = len(x)

# ============================================================
# STEP 2: Least Squares Linear Regression
# ============================================================
sum_x = np.sum(x)
sum_y = np.sum(y)
sum_xy = np.sum(x * y)
sum_x2 = np.sum(x ** 2)

a1 = (n * sum_xy - sum_x * sum_y) / (n * sum_x2 - sum_x ** 2)
a0 = (sum_y - a1 * sum_x) / n
y_pred = a0 + a1 * x

# ============================================================
# STEP 3: Goodness-of-Fit Metrics
# ============================================================
Sr = np.sum((y - y_pred) ** 2)
y_mean = np.mean(y)
St = np.sum((y - y_mean) ** 2)
r2 = 1 - (Sr / St)
s_yx = np.sqrt(Sr / (n - 2))
r = np.sqrt(r2)

# Prediction for Portugal
x_new = 28000
y_pred_new = a0 + a1 * x_new

print("="*60)
print("LAB 03: REAL-WORLD DATA LINEAR REGRESSION")
print("="*60)
print(f"\nRegression Equation: y = {a0:.4f} + {a1:.6f}*x")
print(f"r² = {r2:.4f}, SSE = {Sr:.2f}, s_yx = {s_yx:.4f}")
print(f"Prediction (x=${x_new:,}): y = {y_pred_new:.2f} years")

